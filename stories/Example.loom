        },
        {
          "extraPins": 1,
          "id": 49,
          "pinValues": {
            "textIn": {
              "spans": [
                {
                  "text": "Kolb remembered a story his Gran told him and tossed two gold chits for the ghost, and it faded away, allowing him to pass."
                },
                {
                  "text": "\n"
                },
                {
                  "text": "\n"
                },
                {
                  "text": "(You have "
                },
                {
                  "slot": 0
                },
                {
                  "text": " gold.)"
                }
              ]
            }
          },
          "position": {
            "x": 11040.0,
            "y": 1425.0
          },
          "type": "showText"
        },
        {
          "extraPins": 1,
          "id": 50,
          "pinValues": {
            "option0": "Turn to next page"
          },
          "position": {
            "x": 11985.0,
            "y": 1530.0
          },
          "type": "showChoices"
        },
        {
          "extraPins": 1,
          "id": 51,
          "pinValues": {
            "textIn": {
              "spans": [
                {
                  "text": "Leaving the marsh behind him, Kolb could see the dragon's lair nearby, as well as a small, welcoming tavern."
                }
              ]
            }
          },
          "position": {
            "x": 12930.0,
            "y": 1020.0
          },
          "type": "showText"
        },
        {
          "extraPins": 2,
